<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <title>PhyAR · Pembiasan Ombak Laut</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>
 
  <style>
    :root {
      --green: #23a05a; --green-d: #157a40; --green-l: #dff5e6; --bg: #2e8f4a;
      --navy: #17233d; --yellow: #ffd23f; --white: #ffffff; --red: #e2453f;
    }
    /* No page background: the live camera sits behind the page and must stay visible. */
    html, body {
      margin: 0; height: 100%; overflow: hidden; background: transparent;
      font-family: "Baloo 2", system-ui, sans-serif; color: var(--navy);
      -webkit-user-select: none; user-select: none; touch-action: none;
    }
    button { font-family: inherit; cursor: pointer; }
 
    /* ---------- start screen ---------- */
    #start { position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column;
      align-items: center; overflow: hidden; text-align: center; background: var(--bg); color: var(--white); }
    #start .cover { position: relative; width: 100%; max-width: 560px; flex: 0 1 auto; }
    #start .cover img { display: block; width: 100%; max-height: 66vh; object-fit: cover;
      object-position: top center; animation: rise .7s ease-out both; }
    #start .cover::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 90px;
      background: linear-gradient(rgba(46,143,74,0), var(--bg)); }
    #start .panel { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 10px; padding: 8px 20px max(18px, env(safe-area-inset-bottom)); margin-top: -40px; position: relative; z-index: 1; }
    #start .sub { font-size: 18px; font-weight: 700; text-shadow: 0 2px 0 rgba(23,35,61,.35); }
    .big { font-size: 22px; font-weight: 800; color: var(--navy); padding: 10px 36px;
      border: 4px solid var(--navy); border-radius: 999px; background: var(--yellow); box-shadow: 0 6px 0 var(--navy); }
    .big:active { transform: translateY(4px); box-shadow: 0 2px 0 var(--navy); }
    #startBtn { font-size: 24px; animation: beat 1.8s ease-in-out infinite; }
    #collectionBtn { font-size: 16px; font-weight: 700; color: var(--white); background: rgba(23,35,61,.35);
      border: 2px solid rgba(255,255,255,.7); border-radius: 999px; padding: 6px 18px; }
    #start .note { font-size: 13px; opacity: .9; }
    @keyframes beat { 0%,100% { transform: scale(1); } 50% { transform: scale(1.06); } }
    @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
 
    /* ---------- in-AR interface ---------- */
    .pill { position: fixed; z-index: 20; padding: 6px 16px; border-radius: 999px; font-weight: 700;
      white-space: nowrap; border: 3px solid var(--navy); box-shadow: 0 4px 0 rgba(23,35,61,.35);
      transition: opacity .3s; }
    .center { left: 50%; transform: translateX(-50%); }
    .hidden { opacity: 0 !important; pointer-events: none !important; }
    #progress { top: max(14px, env(safe-area-inset-top)); left: 14px; background: var(--white); font-size: 15px; color: var(--navy); }
    #title { top: max(60px, calc(env(safe-area-inset-top) + 46px)); background: var(--white); font-size: 17px;
      max-width: calc(100% - 40px); overflow: hidden; text-overflow: ellipsis; pointer-events: none; }
    #hint { bottom: 110px; background: var(--green); color: var(--white); font-size: 16px; pointer-events: none; }
    #loading { top: 46%; background: var(--white); font-size: 16px; pointer-events: none; }
    #loading::before { content: ""; display: inline-block; width: 14px; height: 14px; margin-right: 8px;
      border: 3px solid var(--green); border-top-color: transparent; border-radius: 50%;
      vertical-align: -2px; animation: spin .8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
 
    #frame { position: fixed; z-index: 15; left: 50%; top: 46%; width: 56vw; max-width: 260px; aspect-ratio: 2 / 3;
      transform: translate(-50%, -50%); pointer-events: none; transition: opacity .3s; }
    #frame i { position: absolute; width: 34px; height: 34px; border: 6px solid var(--white);
      filter: drop-shadow(0 2px 3px rgba(0,0,0,.4)); animation: pulse 1.6s ease-in-out infinite; }
    #frame i:nth-child(1) { left: 0; top: 0; border-right: 0; border-bottom: 0; border-radius: 14px 0 0 0; }
    #frame i:nth-child(2) { right: 0; top: 0; border-left: 0; border-bottom: 0; border-radius: 0 14px 0 0; }
    #frame i:nth-child(3) { left: 0; bottom: 0; border-right: 0; border-top: 0; border-radius: 0 0 0 14px; }
    #frame i:nth-child(4) { right: 0; bottom: 0; border-left: 0; border-top: 0; border-radius: 0 0 14px 0; }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .45; } }
 
    #bar { position: fixed; z-index: 20; left: 0; right: 0; bottom: max(18px, env(safe-area-inset-bottom));
      display: flex; justify-content: center; gap: 12px; }
    .btn { width: 58px; height: 58px; border-radius: 50%; font-size: 24px; border: 4px solid var(--navy);
      background: var(--white); box-shadow: 0 5px 0 var(--navy); display: flex; align-items: center; justify-content: center; }
    .btn:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--navy); }
    .btn.on { background: var(--yellow); }
    #resetBtn, #quizBtn, #labelBtn { display: none; }
 
    /* temperature slider */
    #simPanel { position: fixed; z-index: 21; left: 50%; transform: translateX(-50%);
      bottom: calc(max(18px, env(safe-area-inset-bottom)) + 74px); width: min(92vw, 420px);
      background: var(--white); border: 3px solid var(--navy); border-radius: 20px;
      box-shadow: 0 5px 0 rgba(23,35,61,.35); padding: 8px 16px 10px; box-sizing: border-box; transition: opacity .3s; }
    #simPanel .row { display: flex; justify-content: space-between; align-items: baseline; font-weight: 700; }
    #simPanel .val { font-size: 22px; font-weight: 800; color: var(--red); }
    #simPanel .small { font-size: 13px; color: #45506a; line-height: 1.25; }
    #dT { width: 100%; height: 34px; accent-color: var(--red); margin: 2px 0; }
 
    /* hotspots */
    #hotspots { position: fixed; inset: 0; z-index: 18; pointer-events: none; }
    .hotspot { position: absolute; width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%;
      background: var(--yellow); border: 3px solid var(--navy); pointer-events: auto; padding: 0;
      font-size: 15px; font-weight: 800; color: var(--navy); }
    .hotspot::after { content: ""; position: absolute; inset: -8px; border-radius: 50%;
      border: 3px solid var(--yellow); animation: ring 1.6s ease-out infinite; }
    @keyframes ring { from { transform: scale(.6); opacity: 1; } to { transform: scale(1.4); opacity: 0; } }
    .hotspot.seen { background: var(--white); }
    .hotspot.seen::after { display: none; }
    #bubble { position: fixed; z-index: 30; left: 50%; transform: translateX(-50%); top: 20%;
      width: min(86vw, 360px); box-sizing: border-box; background: var(--white); border: 3px solid var(--navy);
      border-radius: 18px; padding: 12px 16px; box-shadow: 0 6px 0 rgba(23,35,61,.35); transition: opacity .25s; }
    #bubble b { display: block; font-size: 19px; color: var(--green-d); }
    #bubble p { margin: 4px 0 0; font-size: 15px; line-height: 1.35; }
 
    /* bottom sheet (POE + quiz) */
    #sheet { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; max-height: 78vh; overflow-y: auto;
      background: var(--white); border-radius: 26px 26px 0 0; border-top: 4px solid var(--navy);
      padding: 18px 18px max(20px, env(safe-area-inset-bottom)); box-sizing: border-box;
      box-shadow: 0 -8px 24px rgba(0,0,0,.25); transition: transform .35s cubic-bezier(.2,1.3,.4,1); }
    #sheet.closed { transform: translateY(110%); }
    #sheet .tag { display: inline-block; font-size: 13px; font-weight: 800; color: var(--white);
      background: var(--green); border-radius: 999px; padding: 2px 12px; }
    #sheet h3 { margin: 8px 0 12px; font-size: 20px; line-height: 1.25; }
    #sheet p { margin: 6px 0 12px; font-size: 16px; line-height: 1.4; }
    .opt { display: block; width: 100%; text-align: left; margin: 8px 0; padding: 10px 14px; font-size: 16px;
      font-weight: 700; color: var(--navy); background: var(--green-l); border: 3px solid var(--navy);
      border-radius: 14px; box-shadow: 0 4px 0 var(--navy); }
    .opt:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--navy); }
    .opt.right { background: #b9f0c8; } .opt.wrong { background: #ffd0cc; }
    .next { margin-top: 6px; width: 100%; }
    .stars { font-size: 32px; letter-spacing: 4px; }
 
    /* toast + collection */
    #toast { position: fixed; z-index: 70; left: 50%; top: 18%; transform: translateX(-50%) scale(.8);
      background: var(--yellow); border: 4px solid var(--navy); border-radius: 22px; padding: 12px 20px;
      text-align: center; font-weight: 800; font-size: 18px; box-shadow: 0 6px 0 var(--navy);
      opacity: 0; pointer-events: none; transition: opacity .3s, transform .3s; }
    #toast.show { opacity: 1; transform: translateX(-50%) scale(1); }
    #toast .em { font-size: 40px; display: block; }
 
    #collection { position: fixed; z-index: 60; inset: 0; background: rgba(23,35,61,.55);
      display: flex; align-items: flex-end; justify-content: center; transition: opacity .25s; }
    #collection .box { width: 100%; max-width: 560px; max-height: 88vh; overflow-y: auto; background: var(--white);
      border-radius: 26px 26px 0 0; border-top: 4px solid var(--navy); padding: 16px 16px 24px; box-sizing: border-box; }
    #collection h3 { margin: 0 0 4px; font-size: 22px; }
    #collection .bar { height: 14px; border-radius: 7px; background: var(--green-l); border: 2px solid var(--navy); overflow: hidden; }
    #collection .bar i { display: block; height: 100%; background: var(--green); }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 12px 0; }
    .slot { aspect-ratio: 2 / 3; border-radius: 12px; border: 3px solid var(--navy); background: #eef1f5;
      display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4px;
      text-align: center; font-size: 11px; font-weight: 700; line-height: 1.1; color: #7b8496; overflow: hidden; }
    .slot .n { font-size: 20px; font-weight: 800; }
    .slot.found { background: var(--green-l); color: var(--navy); }
    .slot.found .n { color: var(--green-d); }
    .badges { display: flex; flex-wrap: wrap; gap: 6px; }
    .badge { font-size: 14px; font-weight: 700; padding: 4px 10px; border-radius: 999px; border: 2px solid var(--navy); background: var(--yellow); }
    .badge.locked { background: #eef1f5; color: #7b8496; border-color: #c9d0da; }
  </style>
 
  <script>
    /* ==================================================================
       TETAPAN KAD  (edit di sini sahaja)
       Susunan mesti SAMA dengan susunan gambar semasa compile phyar-16-kad.mind
 
       title  : tajuk kad                     topic : subtopik (untuk lencana)
       video  : fail video ("" jika tiada)    key   : "green" | "black" | "none"
       model  : fail 3D .glb ("" jika tiada)  motion: "none" | "bob" | "spin" | "slide"
       scale/y: saiz & kedudukan video atas kad
       sim    : simulasi interaktif dengan gelongsor suhu (kad pembiasan siang)
       poe    : soalan Ramal-Perhati-Terang sebelum animasi (null jika tiada)
       labels : titik maklumat di atas kad. x: -0.5 (kiri) hingga 0.5 (kanan),
                y: -0.75 (bawah) hingga 0.75 (atas)
       quiz   : soalan kuiz selepas animasi ([] jika tiada)
       ================================================================== */
    const blank = (n) => ({ title: "Kad " + n, topic: "", video: "video-" + String(n).padStart(2, "0") + ".mp4",
      key: "black", model: "", motion: "none", scale: 1, y: 0.05, sim: null, poe: null, labels: [], quiz: [] });
 
    const CARDS = [
      /* ---------- Kad: Pembiasan Ombak Laut ---------- */
      {
        title: "Pembiasan Ombak Laut",
        topic: "Pembiasan",
        video: "",                 // tiada video: kad ini guna simulasi interaktif di bawah
        key: "none", model: "", motion: "none", scale: 1, y: 0.05,
        sim: {
          type: "ombak",
          left: -0.47, right: 0.47, bottom: 0.042,   // kawasan laut pada kad
          // garis pantai pada gambar kad (koordinat piksel gambar 1024 × 1536)
          shorePx: [[30, 415], [100, 420], [150, 430], [200, 450], [260, 480], [300, 500], [330, 505], [370, 495],
                    [420, 460], [470, 435], [530, 428], [590, 435], [640, 460], [690, 495], [730, 505], [770, 495],
                    [810, 470], [850, 440], [900, 425], [995, 415]],
          headlandsPx: [[330, 505], [730, 505]],     // hujung tanjung
          rayStartX: [-0.33, -0.10, 0.018, 0.135, 0.36],   // tempat anak panah bermula
          startA: 100,             // beza kedalaman permulaan (%)
        },
        poe: {
          q: "Ombak bergerak dari laut dalam ke arah pantai yang mempunyai tanjung dan teluk. Di manakah tenaga ombak akan menumpu?",
          options: ["🪨 Di tanjung", "🏖️ Di teluk", "↔️ Sama rata di sepanjang pantai"],
          answer: 0,
          explain: "Air di hadapan tanjung lebih cetek, jadi ombak di situ bergerak lebih perlahan. Muka gelombang melengkung mengikut bentuk pantai dan arah perambatan membengkok ke arah tanjung. Tenaga menumpu di tanjung (amplitud besar), manakala di teluk tenaga tersebar (ombak tenang).",
        },
        labels: [
          { x: -0.178, y: 0.235, text: "Tanjung (cetek)", info: "Air di hadapan tanjung cetek. Ombak bergerak perlahan dan panjang gelombangnya pendek. Tenaga menumpu di sini, jadi amplitud ombak besar." },
          { x: 0.018, y: 0.27, text: "Teluk (dalam)", info: "Air di teluk lebih dalam. Ombak bergerak lebih laju dengan panjang gelombang panjang. Tenaga tersebar, jadi ombak lebih tenang." },
          { x: -0.06, y: 0.16, text: "Muka gelombang", info: "Muka gelombang melengkung mengikut bentuk garis pantai kerana bahagian di kawasan cetek bergerak lebih perlahan." },
          { x: 0.33, y: 0.12, text: "Arah perambatan", info: "Sentiasa berserenjang dengan muka gelombang. Ia membengkok dan menumpu ke arah tanjung." },
          { x: 0.213, y: 0.215, text: "Tenaga menumpu", info: "Banyak arah perambatan bertemu di tanjung, jadi tenaga ombak tertumpu di sini. Sebab itu tanjung lebih cepat terhakis." },
        ],
        quiz: [
          { q: "Mengapakah ombak bergerak lebih perlahan di tanjung?",
            options: ["Air di tanjung lebih cetek", "Air di tanjung lebih dalam", "Angin lebih kuat di tanjung"],
            answer: 0, explain: "Laju ombak berkurang apabila kedalaman air berkurang." },
          { q: "Apakah yang berlaku kepada panjang gelombang apabila ombak memasuki kawasan cetek?",
            options: ["Menjadi lebih pendek", "Menjadi lebih panjang", "Tidak berubah"],
            answer: 0, explain: "Frekuensi tidak berubah. Daripada v = fλ, apabila v berkurang, λ juga berkurang." },
          { q: "Di manakah amplitud ombak lebih besar?",
            options: ["Di tanjung", "Di teluk", "Sama besar"],
            answer: 0, explain: "Tenaga ombak menumpu di tanjung, jadi amplitud ombak di situ lebih besar." },
          { q: "Kawasan manakah lebih sesuai untuk aktiviti berenang?",
            options: ["Teluk", "Tanjung"],
            answer: 0, explain: "Di teluk tenaga ombak tersebar, jadi ombak lebih tenang dan selamat." },
        ],
      },
    ];
 
    const GREEN_CUT = 0.08;   // naikkan jika latar hijau masih kelihatan
    const BLACK_CUT = 0.07;   // naikkan jika latar hitam masih kelihatan
    const MODEL_SIZE = 0.8;   // saiz model 3D berbanding lebar kad
 
    /* ---------- saved progress (kept on this phone only) ---------- */
    const store = {
      get(k, d) { try { const v = localStorage.getItem("phyar_" + k); return v ? JSON.parse(v) : d; } catch (e) { return d; } },
      set(k, v) { try { localStorage.setItem("phyar_" + k, JSON.stringify(v)); } catch (e) {} },
    };
    const progress = { found: store.get("found", []), stars: store.get("stars", {}) };
    const TOPICS = [...new Set(CARDS.map((c) => c.topic).filter(Boolean))];
    const totalStars = () => Object.values(progress.stars).reduce((a, b) => a + b, 0);
    const topicDone = (t) => CARDS.every((c, i) => c.topic !== t || progress.found.includes(i));
 
    function saveProgress() { store.set("found", progress.found); store.set("stars", progress.stars); updateProgressUI(); }
    function addStars(cardIndex, key, n) {
      const k = cardIndex + ":" + key;
      if ((progress.stars[k] || 0) < n) { progress.stars[k] = n; saveProgress(); }
    }
    function markFound(i) {
      if (progress.found.includes(i)) return;
      const before = TOPICS.filter(topicDone);
      progress.found.push(i);
      saveProgress();
      const newBadge = TOPICS.find((t) => topicDone(t) && !before.includes(t));
      if (newBadge) toast("🏅", "Lencana baru!<br>Pakar " + newBadge);
      else toast("🃏", "Kad baru dijumpai! " + progress.found.length + "/" + CARDS.length);
    }
 
    /* ---------- interface helpers ---------- */
    const UI = {};
    let soundOn = true, activeCard = null, labelsOn = true;
    const allVideos = [];
    function setTitle(t) { UI.title.textContent = t || ""; UI.title.classList.toggle("hidden", !t); }
    function setLoading(on) { UI.loading.classList.toggle("hidden", !on); }
    function setScanning(on) { UI.hint.classList.toggle("hidden", !on); UI.frame.style.opacity = on ? 1 : 0; }
    let toastTimer;
    function toast(em, html) {
      UI.toast.innerHTML = '<span class="em">' + em + "</span>" + html;
      UI.toast.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => UI.toast.classList.remove("show"), 2200);
    }
    function updateProgressUI() {
      if (!UI.progress) return;
      UI.progress.textContent = "🃏 " + progress.found.length + "/" + CARDS.length + "  ⭐ " + totalStars();
      UI.collectionBtn.textContent = "🃏 Koleksi Saya (" + progress.found.length + "/" + CARDS.length + ")";
    }
    function openSheet(html) { UI.sheet.innerHTML = html; UI.sheet.classList.remove("closed"); }
    function closeSheet() { UI.sheet.classList.add("closed"); }
 
    /* ---------- video shader (green/black removal + rounded corners) ---------- */
    const VERT = `varying vec2 vUv;
      void main() { vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`;
    const FRAG = `uniform sampler2D map; uniform float keyMode, greenCut, blackCut, aspect;
      varying vec2 vUv;
      void main() {
        vec4 c = texture2D(map, vUv); float a = 1.0;
        if (keyMode > 0.5 && keyMode < 1.5) { float g = c.g - max(c.r, c.b);
          a = 1.0 - smoothstep(greenCut, greenCut + 0.12, g); if (g > 0.0) c.g = mix(c.g, max(c.r, c.b), 0.85); }
        else if (keyMode > 1.5) { float l = max(c.r, max(c.g, c.b)); a = smoothstep(blackCut, blackCut + 0.10, l); }
        vec2 p = abs(vUv - 0.5) * vec2(aspect, 1.0); vec2 h = vec2(aspect, 1.0) * 0.5 - 0.06;
        a *= 1.0 - smoothstep(-0.004, 0.004, length(max(p - h, 0.0)) - 0.06);
        if (a < 0.02) discard; gl_FragColor = vec4(c.rgb, a);
      }`;
    const easeOutBack = (t) => { const c = 1.9; return 1 + (c + 1) * Math.pow(t - 1, 3) + c * Math.pow(t - 1, 2); };
 
    /* ==================================================================
       Interactive simulation: sound refraction in a temperature gradient.
       Sound speed falls with height, v(h) = v0 - g*h. For a linear gradient
       every wavefront is an exact circle whose centre drifts, and every ray
       is a circular arc, so the bending shown is physically correct.
       ================================================================== */
    function makeRefractionSim(cfg, group) {
      const S = 0.1;                          // card units per simulation unit
      const sx = cfg.src[0], sy = cfg.src[1], G0 = cfg.ground;
      const HS = (sy - G0) / S;               // source height above the ground
      const N = 6, SEG = 64, PERIOD = 4.0, W = 0.009;
      const RMAX = (cfg.right - sx) / S + 1.5;
      const night = cfg.mode === "malam";     // night: cool ground, warmer air above
      const sim = { dT: cfg.startDT, clock: 0, night };
      const mkMat = (col) => new THREE.MeshBasicMaterial({ color: col, transparent: true, depthWrite: false, side: THREE.DoubleSide });
 
      // warm air band: stronger colour when the ground is hotter
      const bandMat = new THREE.ShaderMaterial({
        transparent: true, depthWrite: false, uniforms: { k: { value: 0 } }, vertexShader: VERT,
        fragmentShader: `uniform float k; varying vec2 vUv;
          void main() { gl_FragColor = vec4(` + (night ? "0.35, 0.75, 1.0" : "1.0, 0.55, 0.15") + `, (1.0 - vUv.y) * k); }`,
      });
      const band = new THREE.Mesh(new THREE.PlaneGeometry(cfg.right + 0.47, 0.07), bandMat);
      band.position.set((cfg.right - 0.47) / 2, G0 + 0.035, 0.003);
      group.add(band);
 
      // wavefronts: fixed-size ribbons whose vertices are recomputed each frame
      const fronts = [];
      for (let i = 0; i < N; i++) {
        const geo = new THREE.BufferGeometry();
        geo.setAttribute("position", new THREE.BufferAttribute(new Float32Array(SEG * 6 * 3), 3));
        const mesh = new THREE.Mesh(geo, mkMat(0x18d3ff));
        mesh.position.z = 0.006; mesh.frustumCulled = false;
        group.add(mesh); fronts.push(mesh);
      }
      const rayMesh = new THREE.Mesh(new THREE.BufferGeometry(), mkMat(0xff3b30));
      const head = new THREE.Mesh(new THREE.BufferGeometry(), mkMat(0xff3b30));
      [rayMesh, head].forEach((m) => { m.position.z = 0.008; m.frustumCulled = false; group.add(m); });
 
      // speed gradient (exaggerated so the bending is visible); negative at night = speed grows with height
      const gOf = () => (night ? -1 : 1) * 0.011 * sim.dT;
      const front = (t, g) => {
        if (Math.abs(g) < 1e-4) return [HS, t];
        const A = 1 / g - HS;
        return [1 / g - A * Math.cosh(g * t), A * Math.sinh(g * t)];
      };
