          const q = [x1 + a, y1 + b, x1 - a, y1 - b, x2 + a, y2 + b, x2 + a, y2 + b, x1 - a, y1 - b, x2 - a, y2 - b];
          for (let n = 0; n < 6; n++) { arr[o + n * 3] = q[n * 2]; arr[o + n * 3 + 1] = q[n * 2 + 1]; arr[o + n * 3 + 2] = 0; }
