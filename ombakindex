      /* ---------- Predict → Observe → Explain ---------- */
      askPOE: function () {
        const p = this.cfg.poe;
        openSheet('<span class="tag">🤔 RAMAL</span><h3>' + p.q + "</h3>" +
          p.options.map((o, i) => '<button class="opt" data-i="' + i + '">' + o + "</button>").join(""));
        UI.sheet.querySelectorAll(".opt").forEach((b) => b.addEventListener("click", () => {
          this.prediction = +b.dataset.i;
          this.poeState = "watch";
          closeSheet();
          toast("👀", "PERHATI<br>Lihat apa yang berlaku!");
          this.showContent();
          clearTimeout(this.poeTimer);
          this.poeTimer = setTimeout(() => this.explainPOE(), 7000);
        }));
      },
      explainPOE: function () {
        const p = this.cfg.poe, right = this.prediction === p.answer;
        if (right) addStars(this.idx, "poe", 1);
        openSheet('<span class="tag">💡 TERANG</span><h3>' + (right ? "Ramalan anda betul! 🎉" : "Hmm, perhatikan semula 🤔") + "</h3>" +
          "<p><b>Jawapan:</b> " + p.options[p.answer] + "</p><p>" + p.explain + "</p>" +
          (this.sim ? "<p>🌡️ Cuba gelongsor suhu dan lihat perubahannya!</p>" : "") +
          '<button class="big next">Teruskan</button>');
        UI.sheet.querySelector(".next").addEventListener("click", () => { this.poeState = "done"; closeSheet(); });
      },
 
      /* ---------- quiz ---------- */
      startQuiz: function () {
        const qs = this.cfg.quiz; let n = 0, score = 0;
        const show = () => {
          if (n >= qs.length) {
            addStars(this.idx, "quiz", score);
            openSheet('<span class="tag">⭐ KUIZ</span><h3>Tahniah!</h3><div class="stars">' +
              "⭐".repeat(score) + "☆".repeat(qs.length - score) + "</div><p>Anda dapat " + score + "/" + qs.length + ".</p>" +
              '<button class="big next">Tutup</button>');
            UI.sheet.querySelector(".next").addEventListener("click", closeSheet);
            return;
          }
          const q = qs[n];
          openSheet('<span class="tag">⭐ KUIZ ' + (n + 1) + "/" + qs.length + "</span><h3>" + q.q + "</h3>" +
            q.options.map((o, i) => '<button class="opt" data-i="' + i + '">' + o + "</button>").join("") + '<div class="fb"></div>');
          const opts = UI.sheet.querySelectorAll(".opt");
          opts.forEach((b) => b.addEventListener("click", () => {
            const ok = +b.dataset.i === q.answer;
            if (ok) score++;
            opts.forEach((o) => { o.disabled = true; if (+o.dataset.i === q.answer) o.classList.add("right"); });
            if (!ok) b.classList.add("wrong");
            UI.sheet.querySelector(".fb").innerHTML = "<p>" + (ok ? "✅ Betul! " : "❌ Belum tepat. ") + q.explain + "</p>" +
              '<button class="big next">' + (n + 1 < qs.length ? "Seterusnya ▶" : "Lihat markah") + "</button>";
            UI.sheet.querySelector(".next").addEventListener("click", () => { n++; show(); });
          }));
        };
        show();
      },
 
      tick: function (t, dt) {
        if (!this.visible) return;
        const sec = Math.min((dt || 16) / 1000, 0.1);
        this.clock += sec;
        if (this.holder.visible) {
          if (this.popT < 1) {
            this.popT = Math.min(1, this.popT + sec / 0.45);
            this.holder.scale.setScalar(Math.max(0.001, easeOutBack(this.popT)));
          }
          if (this.vplane) this.vplane.scale.setScalar(this.vbase * this.userScale);
          if (this.sim) this.sim.update(sec);
          if (this.turn) {
            let rot = this.userRot, x = 0, lift = 0;
            if (this.cfg.motion === "spin") rot += this.clock * 0.8;
            if (this.cfg.motion === "bob") lift = 0.03 + Math.sin(this.clock * 3) * 0.03;
            if (this.cfg.motion === "slide") x = Math.sin(this.clock * 0.9) * 0.25;
            this.turn.rotation.z = rot; this.turn.position.set(x, 0, lift); this.turn.scale.setScalar(this.userScale);
          }
          if (this.mixer) this.mixer.update(sec);
        }
        // keep the tap-to-reveal dots glued to the card on screen
        const cam = this.el.sceneEl.camera, canvas = this.el.sceneEl.canvas;
        if (!cam || !canvas || !this.hotspots.length) return;
        const r = canvas.getBoundingClientRect(), showDots = labelsOn && this.holder.visible;
        this.el.object3D.updateMatrixWorld();
        this.hotspots.forEach((h) => {
          this.tmpV.copy(h.pos).applyMatrix4(this.el.object3D.matrixWorld).project(cam);
          const ok = showDots && this.tmpV.z < 1 && Math.abs(this.tmpV.x) < 1.1 && Math.abs(this.tmpV.y) < 1.1;
          h.el.classList.toggle("hidden", !ok);
          if (ok) {
            h.el.style.left = (r.left + (this.tmpV.x + 1) / 2 * r.width) + "px";
            h.el.style.top = (r.top + (1 - this.tmpV.y) / 2 * r.height) + "px";
          }
        });
      },
    });
 
    /* each simulation describes its own slider (label, value, explanation) */
    function updateSimText(v) {
      const s = activeCard && activeCard.sim;
      if (!s) return;
      const r = s.text(+v);
      UI.dTlabel.textContent = r.label; UI.dTval.textContent = r.val; UI.dTinfo.innerHTML = r.info;
    }
 
    /* ---------- touch: drag to rotate models, pinch to zoom ---------- */
    (function () {
      const pts = new Map(); let lastX = 0, startDist = 0, startScale = 1;
      const isUI = (e) => e.target.closest && e.target.closest("button, input, #start, #sheet, #simPanel, #collection, #bubble");
      window.addEventListener("pointerdown", (e) => {
        if (isUI(e)) return;
        pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); lastX = e.clientX;
        if (pts.size === 2 && activeCard) {
          const [a, b] = [...pts.values()];
          startDist = Math.hypot(a.x - b.x, a.y - b.y); startScale = activeCard.userScale;
        }
      });
      window.addEventListener("pointermove", (e) => {
        if (!pts.has(e.pointerId)) return;
        pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (!activeCard) return;
        if (pts.size === 1 && activeCard.turn) { activeCard.userRot += (e.clientX - lastX) * 0.012; lastX = e.clientX; }
        else if (pts.size === 2 && startDist > 0) {
          const [a, b] = [...pts.values()];
          activeCard.userScale = Math.min(2.5, Math.max(0.5, startScale * Math.hypot(a.x - b.x, a.y - b.y) / startDist));
        }
      });
      const up = (e) => { pts.delete(e.pointerId); if (pts.size === 1) lastX = [...pts.values()][0].x; };
      window.addEventListener("pointerup", up); window.addEventListener("pointercancel", up);
    })();
  </script>
</head>
 
<body>
  <!-- start screen -->
  <div id="start">
    <div class="cover"><img src="../cover.jpg" alt="PhyAR Deck" /></div>
    <div class="panel">
      <div class="sub">Pembiasan Ombak Laut · Fizik Tingkatan 4</div>
      <button id="startBtn" class="big">Mula Imbas ▶</button>
      <button id="collectionBtn">🃏 Koleksi Saya</button>
      <div class="note">Benarkan akses kamera bila diminta 📷</div>
    </div>
  </div>
 
  <div id="frame"><i></i><i></i><i></i><i></i></div>
  <button id="progress" class="pill">🃏 0/1 ⭐ 0</button>
  <div id="title" class="pill center hidden"></div>
  <div id="loading" class="pill center hidden">Memuatkan…</div>
  <div id="hint" class="pill center">Halakan kamera ke kad PhyAR 📱</div>
  <div id="hotspots"></div>
  <div id="bubble" class="hidden"></div>
 
  <div id="simPanel" class="hidden">
    <div class="row"><span id="dTlabel">🌡️ Beza suhu tanah – udara</span><span id="dTval" class="val">10 °C</span></div>
    <input id="dT" type="range" min="0" max="15" step="1" value="10" />
    <div id="dTinfo" class="small"></div>
  </div>
 
  <div id="bar">
    <button id="soundBtn" class="btn on" aria-label="Bunyi">🔊</button>
    <button id="labelBtn" class="btn on" aria-label="Label">🏷️</button>
    <button id="quizBtn" class="btn" aria-label="Kuiz">⭐</button>
    <button id="resetBtn" class="btn" aria-label="Set semula">↺</button>
  </div>
 
  <div id="sheet" class="closed"></div>
  <div id="toast"></div>
  <div id="collection" class="hidden"><div class="box"></div></div>
 
  <a-scene
    mindar-image="imageTargetSrc: ../phyar-16-kad.mind; autoStart: false; uiLoading: no; uiScanning: no; maxTrack: 1; filterMinCF: 0.0001; filterBeta: 0.001"
    renderer="colorManagement: true; alpha: true; antialias: true; precision: high"
    vr-mode-ui="enabled: false" device-orientation-permission-ui="enabled: false">
    <a-camera position="0 0 0" look-controls="enabled: false"></a-camera>
    <a-entity light="type: ambient; intensity: 1.1"></a-entity>
    <a-entity light="type: directional; intensity: 1.3" position="0.5 1 1.5"></a-entity>
    <!-- KEDUDUKAN KAD OMBAK dalam phyar-16-kad.mind: kad pertama = 0, jadi kad ke-15 = 14.
         Tukar nombor 14 jika kad ombak berada di kedudukan lain. -->
    <a-entity mindar-image-target="targetIndex: 14" phyar-card="index: 0"></a-entity>
  </a-scene>
 
  <script>
    ["title", "loading", "hint", "frame", "progress", "hotspots", "bubble", "simPanel", "dT", "dTlabel", "dTval", "dTinfo",
     "resetBtn", "quizBtn", "labelBtn", "soundBtn", "sheet", "toast", "collection", "collectionBtn"]
      .forEach((id) => (UI[id] = document.getElementById(id)));
    const scene = document.querySelector("a-scene");
    updateProgressUI();
 
    function startAR() {
      document.getElementById("start").style.display = "none";
      const go = () => scene.systems["mindar-image-system"].start();
      if (scene.hasLoaded) go(); else scene.addEventListener("loaded", go, { once: true });
    }
    document.getElementById("startBtn").addEventListener("click", startAR);
 
    UI.soundBtn.addEventListener("click", () => {
      soundOn = !soundOn;
      allVideos.forEach((v) => (v.muted = !soundOn));
      UI.soundBtn.textContent = soundOn ? "🔊" : "🔇";
      UI.soundBtn.classList.toggle("on", soundOn);
    });
    UI.labelBtn.addEventListener("click", () => {
      labelsOn = !labelsOn; UI.labelBtn.classList.toggle("on", labelsOn);
      if (!labelsOn) UI.bubble.classList.add("hidden");
    });
    UI.resetBtn.addEventListener("click", () => { if (activeCard) { activeCard.userRot = 0; activeCard.userScale = 1; } });
    UI.quizBtn.addEventListener("click", () => { if (activeCard) activeCard.startQuiz(); });
    UI.dT.addEventListener("input", () => {
      updateSimText(UI.dT.value);
      if (activeCard && activeCard.sim) activeCard.sim.setDT(+UI.dT.value);
    });
    UI.bubble.addEventListener("click", () => UI.bubble.classList.add("hidden"));
 
    /* ---------- collection screen ---------- */
    function openCollection() {
      const n = progress.found.length;
      UI.collection.querySelector(".box").innerHTML =
        "<h3>🃏 Koleksi Kad Saya</h3><p style='margin:0 0 6px'>" + n + "/" + CARDS.length + " kad dijumpai · ⭐ " + totalStars() + "</p>" +
        '<div class="bar"><i style="width:' + (100 * n / CARDS.length) + '%"></i></div>' +
        '<div class="grid">' + CARDS.map((c, i) => {
          const f = progress.found.includes(i);
          return '<div class="slot' + (f ? " found" : "") + '"><span class="n">' + (f ? "✓" : "🔒") + "</span>" +
            (f ? c.title : "Kad " + (i + 1)) + "</div>";
        }).join("") + "</div>" +
        (TOPICS.length ? "<b>🏅 Lencana</b><div class='badges' style='margin:6px 0 14px'>" +
          TOPICS.map((t) => '<span class="badge' + (topicDone(t) ? "" : " locked") + '">' + (topicDone(t) ? "🏅 " : "🔒 ") + "Pakar " + t + "</span>").join("") +
          "</div>" : "") +
        '<button class="big next" id="closeCol">Tutup</button>';
      UI.collection.classList.remove("hidden");
      document.getElementById("closeCol").addEventListener("click", () => UI.collection.classList.add("hidden"));
    }
    UI.collectionBtn.addEventListener("click", openCollection);
    UI.progress.addEventListener("click", openCollection);
  </script>
</body>
</html>
